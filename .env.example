# Cổng server API (mặc định 3000)
PORT=3000

# Đường dẫn file SQLite (mặc định ./data/quaythuoc.sqlite)
DATABASE_URL=./data/quaythuoc.sqlite

# Origin được gọi API từ trình duyệt khi API chạy ở domain riêng, ngăn cách bằng
# dấu phẩy. Để trống nếu app và API cùng origin (proxy /api).
CORS_ORIGINS=

# Đăng nhập: chưa có tài khoản nào khi mới cài. Tạo admin đầu tiên bằng lệnh
# (hỏi mật khẩu trên terminal, không hiện ký tự):
#   npm run tao-admin -- <tenDangNhap>
# Sau đó admin thêm nhân viên trong Cài đặt → Người dùng.
